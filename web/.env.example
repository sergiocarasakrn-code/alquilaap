DATABASE_URL="postgresql://alquilaap:alquilaap@localhost:5432/alquilaap"
# Clave para cifrar (HMAC) el DNI/NIE. Cámbiala en producción.
ID_HASH_SECRET="cambia-esto"
APP_URL="http://localhost:3000"
# Stripe en modo prueba. Sin estas claves, en desarrollo se puede simular el pago.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Solo desarrollo: aprobar la verificación de identidad al enviarla (en producción irá Stripe Identity).
KYC_AUTO_APPROVE="true"
# Administradores (pueden aprobar verificaciones y ver incidencias), separados por comas.
ADMIN_EMAILS=""
# Fotos y documentos en Cloudflare R2 (o cualquier S3). Sin estas variables se guardan en storage-data/ (solo local).
S3_ENDPOINT=""          # p. ej. https://<id-de-cuenta>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Avisos por email cuando alguien te escribe (https://resend.com). Sin ellas, los avisos solo se ven en la app.
RESEND_API_KEY=""
EMAIL_FROM=""            # p. ej. "Alquilaap <avisos@alquilaap.es>" (dominio verificado en Resend)

# Datos legales que salen en /privacidad y /condiciones.
LEGAL_NAME=""            # razón social de la empresa
LEGAL_TAX_ID=""          # CIF
LEGAL_ADDRESS=""
CONTACT_EMAIL=""

# App de Android (Google Play). La huella SHA-256 está en Play Console → Integridad de la app → Firma de apps.
ANDROID_PACKAGE=""       # p. ej. es.alquilaap.app
ANDROID_CERT_SHA256=""   # varias separadas por comas
