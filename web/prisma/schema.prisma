// Fase 1 de Alquilaap. Subconjunto de docs/schema-objetivo.sql.
// Migraciones expand/contract: añadir columnas como opcionales, rellenar, y solo después hacerlas obligatorias.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  unverified
  pending
  verified
  rejected
}

enum ListingStatus {
  active
  paused
  deleted
}

enum BookingStatus {
  requested
  accepted
  in_progress
  completed
  incident
  declined
  cancelled
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  createdAt        DateTime  @default(now())
  // Verificación de identidad (antirrobo)
  kycStatus        KycStatus @default(unverified)
  legalName        String?
  idNumberHash     String?   @unique // HMAC del DNI/NIE: nunca guardamos el número en claro
  idNumberLast4    String?
  birthDate        DateTime? @db.Date
  phone            String?
  address          String?
  kycDocumentUrl   String?
  kycSelfieUrl     String?
  kycSubmittedAt   DateTime?
  kycVerifiedAt    DateTime?
  stripeCustomerId String?   @unique
  deletedAt        DateTime? // cuenta borrada: datos personales eliminados, se conserva el historial anónimo

  sessions       Session[]
  listings       Listing[]
  bookingsAsUser Booking[]      @relation("renter")
  bookingsAsOwner Booking[]     @relation("owner")
  packPurchases  PackPurchase[]
  subscription   Subscription?
  reviewsWritten Review[]       @relation("author")
  reviewsGot     Review[]       @relation("target")
  messages       Message[]
  convsAsOwner   Conversation[] @relation("convOwner")
  convsAsRenter  Conversation[] @relation("convRenter")
}

model Session {
  id        String   @id // sha256 del token de la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  title           String
  description     String
  category        String
  subcategory     String? // opcional: los anuncios antiguos no tienen
  city            String
  citySlug        String
  lat             Float?
  lng             Float?
  pricePerDayCents Int
  depositCents    Int           @default(0)
  status          ListingStatus @default(active)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  photos        ListingPhoto[]
  bookings      Booking[]
  packPurchases PackPurchase[]
  conversations Conversation[]

  @@index([status, category, citySlug])
  @@index([status, category, subcategory])
  @@index([ownerId])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([listingId, position])
}

model PackPurchase {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  packCode        String
  amountCents     Int
  status          PaymentStatus @default(pending)
  idempotencyKey  String        @unique
  stripeSessionId String?       @unique
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([listingId, status, endsAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  status               String // active | past_due | canceled | incomplete
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Booking {
  id                 String        @id @default(cuid())
  listingId          String
  listing            Listing       @relation(fields: [listingId], references: [id])
  renterId           String
  renter             User          @relation("renter", fields: [renterId], references: [id])
  ownerId            String
  owner              User          @relation("owner", fields: [ownerId], references: [id])
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date // último día incluido
  days               Int
  priceCents         Int // se paga en mano: Alquilaap no lo cobra
  depositCents       Int
  insuranceCents     Int           @default(0)
  status             BookingStatus @default(requested)
  version            Int           @default(0) // bloqueo optimista
  ownerPickedUpAt    DateTime?
  renterPickedUpAt   DateTime?
  ownerReturnedOkAt  DateTime?
  renterReturnedOkAt DateTime?
  incidentAt         DateTime?
  incidentById       String?
  incidentText       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  events   BookingEvent[]
  reviews  Review[]
  messages Message[]

  @@index([listingId, status])
  @@index([renterId])
  @@index([ownerId])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   String?
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("author", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("target", fields: [targetId], references: [id])
  rating    Int
  text      String
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId])
}

// Una conversación por anuncio y persona interesada: sirve para preguntar antes de reservar
// y es también el chat de sus reservas.
model Conversation {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id])
  ownerId         String
  owner           User      @relation("convOwner", fields: [ownerId], references: [id])
  renterId        String // quien pregunta o alquila
  renter          User      @relation("convRenter", fields: [renterId], references: [id])
  lastMessageAt   DateTime  @default(now())
  lastSenderId    String?
  ownerReadAt     DateTime?
  renterReadAt    DateTime?
  // Último email de aviso enviado a cada parte (para no mandar uno por mensaje).
  ownerEmailedAt  DateTime?
  renterEmailedAt DateTime?
  createdAt       DateTime  @default(now())

  messages Message[]

  @@unique([listingId, renterId])
  @@index([ownerId, lastMessageAt])
  @@index([renterId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookingId      String? // reserva desde la que se escribió, si la hay
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// Eventos de Stripe ya procesados: el webhook es idempotente.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
